# Copy to .env.local. Placeholders only - never commit real values.
# Local values come from `npx supabase status -o env` (README explains).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never NEXT_PUBLIC_
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_OTP_LENGTH=6                           # must match [auth.email] otp_length
CRON_SECRET=generate-a-long-random-string

# Optional integrations. Leave empty and the app simply skips them.
RESEND_API_KEY=
EMAIL_FROM=                                        # e.g. "SangSafar <trips@your-verified-domain>"
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
